# Copia este archivo como .env.local y rellena los valores.
# .env.local NO se sube al repositorio.

# Almacenamiento de productos y cotizaciones (Vercel Blob).
# Se obtiene con: vercel env pull
BLOB_READ_WRITE_TOKEN=

# Contraseña del panel /admin.
# Si se deja vacía se usa la de respaldo definida en lib/auth.ts.
ADMIN_PASSWORD=

# Bearer token de la API Clients External 2.0 de ForPromotional (4promotional.net).
# Se envía como cabecera: Authorization: Bearer <token>
# Se obtiene en el portal de ForPromotional: Menú usuario -> API Token.
# Nunca debe quedar en código del cliente: es una credencial de servidor.
FORPROMOTIONAL_API_TOKEN=

# Valor INICIAL del margen del catálogo, solo mientras nadie lo haya guardado
# desde el panel. A partir de ahí manda el valor de Admin -> Catálogo.
# Es un factor sobre el costo del proveedor: 1.45 = costo + 45%.
CATALOGO_MARGEN=
